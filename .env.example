# Copy this file to ".env" (same folder) and fill in your real values.
# The .env file stays on your computer only and is never uploaded to GitHub.

# From https://www.etsy.com/developers/your-apps  (your app's "Keystring" and "Shared secret")
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# Your shop name exactly as it appears in your shop URL: etsy.com/shop/<ShopName>
ETSY_SHOP_NAME=

# From https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# From https://developers.pinterest.com/apps -> your app's "My apps" page
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Generated once via the OAuth flow (or a trial "product limited token" for early testing)
PINTEREST_ACCESS_TOKEN=
# Only needed for the permanent flow -- lets the automation refresh its own access token
PINTEREST_REFRESH_TOKEN=

# Daily summary email: a burner Gmail account sends it, using an "app password"
# (Google Account -> Security -> 2-Step Verification -> App passwords)
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
# Where the daily summary is delivered
SUMMARY_RECIPIENT=

# From the Meta developer dashboard: Instagram > API setup > Generate token (lasts 60 days; renewed automatically)
INSTAGRAM_ACCESS_TOKEN=
